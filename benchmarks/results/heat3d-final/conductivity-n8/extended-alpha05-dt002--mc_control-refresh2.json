      "material_model": {
        "capacity": "1 + capacity_gamma*u^2",
        "conductivity": "1 + alpha*u^2",
        "source": "F(x,y,z,t) - reaction_sigma*u^3",
        "time_discretization": "c(u_new)*(u_new-u_previous)/dt; implicit Euler, not an enthalpy difference",
